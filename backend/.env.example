# Copy this file to backend/.env (git-ignored, never uploaded) and paste your key.
# Shared public LegalCompass API key (python deploy/make_local_env.py writes it here and to web/.env.local)
LEGALCOMPASS_API_KEY=
# xAI Grok keys start with "xai-", Groq keys with "gsk_". The backend picks a current fast model by itself.
LLM_API_KEY=
# Optional: force a model name from your provider's console instead of the automatic choice
# LLM_MODEL=
